# 복사해서 .env로 저장하고 값을 바꾸세요. .env는 커밋하지 않습니다.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://oona:change-me@127.0.0.1:55440/oona_dev

# 우나 전용 Tailscale 노드 인증 키 (Tailscale 관리 콘솔 > Settings > Keys에서 발급, 처음 연결 후에는 지워도 됨)
TS_AUTHKEY=

# 웹 푸시(VAPID) 키: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://oona.<tailnet>.ts.net

# 인증(Better Auth): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3330
# 개발 DB는 oona_dev, 운영 컨테이너는 oona(docker-compose.yml)

# 우나 주소(Tailscale 전용 노드). 인증·푸시 설정이 이 값을 씀
OONA_URL=https://oona.<tailnet>.ts.net

# 간편 로그인. 비워 두면 해당 버튼이 꺼짐
# 카카오: 앱 > 플랫폼 키 > REST API 키의 값 / 같은 곳의 클라이언트 시크릿 코드
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 네이버: 내 애플리케이션 > 개요의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI(D-060)
# API 키 암호화 마스터 키(32바이트 base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_SECRET=
# 이 PC 주인 계정 아이디. 구독(Claude·ChatGPT) 연결은 이 계정만 쓸 수 있음
OONA_OWNER_USERNAME=
# 구독 로그인 폴더(scripts/ai-login.mts). 운영 컨테이너는 /data/ai-login으로 씀
OONA_AI_LOGIN_DIR=C:/oona-data/ai-login

# 사진 등 첨부 파일 폴더(M-06). 운영 컨테이너는 /data/files로 씀
OONA_FILES_DIR=C:/oona-data/files

# 운영(M-21, docs/operations.md)
# 꺼짐 감시: 하트비트 감시 서비스(예: Healthchecks.io 무료)의 핑 주소. 비워 두면 보내지 않음
HEARTBEAT_URL=
# 백업(scripts/backup.ps1): 기본 C:\oona-data\backups
BACKUP_DIR=
# PC 밖 사본: 외장 드라이브 폴더(세미콜론으로 여러 곳, 연결 안 됐으면 건너뜀) / rclone 암호화 원격 이름
BACKUP_COPY_TO=
BACKUP_RCLONE_REMOTE=
