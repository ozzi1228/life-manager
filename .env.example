# 복사해서 .env로 저장하고 값을 바꾸세요. .env는 커밋하지 않습니다.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://oona:change-me@127.0.0.1:55440/oona_dev

# 우나 전용 Tailscale 노드 인증 키 (Tailscale 관리 콘솔 > Settings > Keys에서 발급, 처음 연결 후에는 지워도 됨)
TS_AUTHKEY=

# 웹 푸시(VAPID) 키: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://oona.<tailnet>.ts.net

# 인증(Better Auth): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3330
# 개발 DB는 oona_dev, 운영 컨테이너는 oona(docker-compose.yml)

# 우나 주소(Tailscale 전용 노드). 인증·푸시 설정이 이 값을 씀
OONA_URL=https://oona.<tailnet>.ts.net
